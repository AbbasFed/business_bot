# Copy this file to .env and fill in ONE of the two keys. Never commit .env.

# Option 1 (default, free): Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=   (leave empty: the code picks a Flash-Lite model, which has the biggest free daily quota)

# Option 2: OpenAI key (used only if no Gemini key is set)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Optional: phone notifications for new leads and feedback (https://pushover.net)
# PUSHOVER_USER=
# PUSHOVER_TOKEN=
